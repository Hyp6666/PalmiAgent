"bionic.pro.help.label" = "Tentang %@";
"bionic.pro.help.mode" = "Mode Bionic menyediakan percakapan karakter dan ingatan berkelanjutan. Layanan model ditagih secara terpisah sesuai konfigurasi Anda. Paket gratis maupun Pro tidak mencakup kredit model.";
"bionic.pro.help.roles2" = "Palmi adalah karakter bawaan yang tidak dapat dihapus. Anda juga dapat menyimpan hingga 2 karakter kustom sekaligus. Saat semua slot terisi, hapus karakter yang ada sebelum membuat yang lain, atau tingkatkan ke Pro untuk lebih banyak slot. Jika Anda menikmati Palmi APP, pembelian Anda juga mendukung pengembangan berkelanjutannya.";
"bionic.pro.help.roles99" = "Simpan hingga 99 karakter kustom selain Palmi bawaan yang tidak dapat dihapus. Saat semua slot terisi, hapus karakter yang ada secara manual sebelum membuat yang lain. Batas menghitung karakter yang saat ini Anda simpan, bukan seluruh karakter yang pernah dibuat.";
"bionic.pro.help.memory" = "Karakter mengatur dan mencatat ingatan selama percakapan untuk digunakan dalam pertukaran mendatang. Paket gratis menggunakan ingatan ini secara otomatis. Pro juga memungkinkan Anda memeriksa, menelusuri, dan mengeditnya.";
"bionic.pro.help.harness" = "Harness mengoordinasikan pengaturan karakter, ingatan, konteks percakapan, dan alat di sekitar model, sehingga memungkinkan interaksi yang digunakan dalam mode Bionic.";
"bionic.pro.help.longChat" = "Percakapan panjang diringkas secara otomatis untuk menjaga kesinambungan. Ini tidak berarti model dapat membaca teks tanpa batas sekaligus atau mengingat setiap kata dalam riwayatnya. Hasil bergantung pada kemampuan model dan perangkat.";
"bionic.pro.help.memoryJump" = "Buka percakapan yang ditautkan dari suatu ingatan untuk memahami asalnya. Percakapan asli harus masih tersimpan di perangkat Anda.";
"bionic.pro.help.diary" = "Baca buku harian yang dibuat karakter untuk melihat cara mereka mencatat pengalaman. Ini adalah narasi karakter yang dibuat model dan mungkin mengandung interpretasi yang tidak akurat.";
"bionic.pro.help.developer" = "Periksa konteks dan informasi diagnostik dari sesi Bionic untuk memahami cara jawaban karakter dibuat. Ditujukan bagi pengguna yang tertarik pada detail cara sistem berjalan.";
"personalization.personality.help" = "Hanya berlaku untuk mode Profesional, untuk menyesuaikan gaya ekspresi dan interaksi. Mode Obrolan tidak menggunakan pengaturan ini; mode Bionic menggunakan pengaturan masing-masing karakter.";
