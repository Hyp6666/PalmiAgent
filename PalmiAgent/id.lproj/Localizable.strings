// Palmi 26.11
"updates.26.11.chat" = "Palmi langsung membuka percakapan. Mode Obrolan dan Profesional kini terasa lebih seragam.";
"updates.26.11.interface" = "Tampilan baru menyatukan riwayat, berkas, keterampilan, dan pengaturan dalam bilah samping.";
"updates.26.11.browser" = "Kendali browser hadir dalam versi beta! Arahkan dengan bahasa sehari-hari di mode Profesional, lihat beberapa halaman, lalu ambil alih untuk masuk atau verifikasi.";
"updates.26.11.models" = "Kelompokkan model dan pilih model bawaan. Pengaturan tiga model lama berpindah otomatis. Anda juga dapat berganti model saat mengobrol.";
"updates.26.11.tools" = "Pilih model tersendiri untuk lebih banyak alat:\nPersetujuan otomatis;\nBantuan visual untuk model yang tidak dapat melihat gambar;\nPencarian web jarak jauh dan pembacaan halaman;\nPembuatan gambar.";
"updates.26.11.interactive" = "Balasan interaktif tanpa pengaturan tambahan: pelikan bersepeda, Qin Shi Huang menunggang beruang kutub, Tetris, atau cuaca, langsung di dalam balasan.";
"updates.26.11.replies" = "Balasan tampil saat ditulis, memadukan teks, gambar, dan konten interaktif. Lanjutkan obrolan dengan saran pesan berikutnya.";
"updates.26.11.files" = "Jelajahi berkas proyek, buka folder, pratinjau dan bagikan berkas, serta lihat lampiran percakapan dengan lebih mudah.";
"updates.26.11.questions" = "Pertanyaan muncul di atas layar saat Palmi membutuhkan keputusan Anda. Jawab berurutan, tambahkan penjelasan, atau kembali ke percakapan asal.";
"updates.26.11.background" = "Pekerjaan latar belakang dan tampilan kemajuan ditingkatkan, termasuk balasan Bionik. Tugas panjang tidak lagi terputus oleh batas waktu dan giliran lama.";
"updates.26.11.bionic" = "Percakapan Bionik, status dibaca, dan pengingat pesan belum dibaca kini lebih baik saat percakapan dibuka.";
"updates.26.11.languages" = "Menambahkan bahasa Jerman, Swedia, Arab, Turki, Indonesia, dan Prancis. Balasan serta judul percakapan lebih mengikuti pilihan bahasa Anda.";
"updates.26.11.navigation" = "Memperbaiki hilangnya percakapan setelah browser diciutkan dan mode yang salah terpilih saat membuka bilah samping dari mode Bionik.";

