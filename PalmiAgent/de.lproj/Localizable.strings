// Palmi 26.11
"updates.26.11.chat" = "Palmi öffnet direkt eine Unterhaltung. Chat und Profi-Modus lassen sich jetzt einheitlicher bedienen.";
"updates.26.11.interface" = "Die neue Oberfläche bündelt Verlauf, Dateien, Skills und Einstellungen in einer Seitenleiste.";
"updates.26.11.browser" = "Browsersteuerung als Beta: Im Profi-Modus den Browser in Alltagssprache steuern, mehrere Seiten ansehen und Anmeldung oder Bestätigung selbst übernehmen.";
"updates.26.11.models" = "Modelle gruppieren und ein Standardmodell wählen. Die bisherige Drei-Modell-Einrichtung wird automatisch übernommen. Modelle lassen sich auch im Gespräch wechseln.";
"updates.26.11.tools" = "Für weitere Werkzeuge eigene Modelle wählen:\nAutomatische Freigabe;\nSehhilfe für Modelle ohne Bildverständnis;\nEntfernte Websuche und Seitenlesen;\nBilderzeugung.";
"updates.26.11.interactive" = "Interaktive Antworten ohne zusätzliche Einrichtung: ein radelnder Pelikan, Qin Shi Huang auf einem Eisbären, Tetris oder das Wetter – direkt in der Antwort.";
"updates.26.11.replies" = "Antworten erscheinen beim Schreiben und verbinden Text, Bilder und interaktive Inhalte. Vorschläge helfen, das Gespräch fortzusetzen.";
"updates.26.11.files" = "Projektdateien gemeinsam durchsuchen, Ordner öffnen, Dateien ansehen und teilen sowie Anhänge leichter finden.";
"updates.26.11.questions" = "Fragen erscheinen über dem aktuellen Bildschirm. Nacheinander antworten, Details ergänzen, oder zum fragenden Gespräch zurückkehren.";
"updates.26.11.background" = "Bessere Hintergrundarbeit mit aktuellerem Fortschritt, auch für Bionic-Antworten. Lange Aufgaben werden nicht mehr durch die bisherigen Zeit- und Rundengrenzen unterbrochen.";
"updates.26.11.bionic" = "Bionic-Gespräche und Lesestatus verbessert. Nach dem Öffnen wird genauer angezeigt, was gelesen ist.";
"updates.26.11.languages" = "Deutsch, Schwedisch, Arabisch, Türkisch, Indonesisch und Französisch ergänzt. Auch Antworten und Gesprächstitel richten sich besser nach der gewählten Sprache.";
"updates.26.11.navigation" = "Behoben: Nach dem Einklappen des Browsers geht die Unterhaltung nicht mehr verloren. Die Seitenleiste zeigt beim Öffnen aus Bionic den richtigen Modus.";

