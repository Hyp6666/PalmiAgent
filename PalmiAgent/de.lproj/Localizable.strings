"updates.neo.timeline.body" = "Der neue Neo-Stil zeigt Denken, Erklärungen und Werkzeugaufrufe im Chat- und professionellen Modus auf einer Zeitleiste.";
"updates.neo.details.title" = "Details und Stilauswahl";
"updates.neo.details.body" = "Klappe Schritte aus, um Inhalte, Ergebnisse und verstrichene Zeit anzuzeigen. Neo ist nach dem Update Standard; deine Auswahl in den Laufzeiteinstellungen wird gespeichert.";
"updates.interaction.title" = "Einstellungen und Nachrichten";
"updates.interaction.settings.title" = "Antwortstile und Modellauswahl";
"updates.interaction.settings.body" = "Beschreibe einen eigenen professionellen Antwortstil mit bis zu 200 Zeichen. Modelle sind nach Quelle gruppiert und Auswahlzustände klarer erkennbar.";
"updates.interaction.unread.title" = "Ungelesene Nachrichten und Mitteilungen";
"updates.interaction.unread.body" = "Anzeigen und Navigation für ungelesene Nachrichten ergänzt sowie gespeicherten Lesestatus und die Synchronisierung der Mitteilungskennzeichen verbessert.";
"updates.modelUsageNote" = "Du konfigurierst deine eigenen Modelle. Verfügbare Modelle und Verbrauch hängen von deinem Dienst ab. Weder Basic noch Bionic Pro enthält Modellguthaben.";
"updates.history.26.9" = "Protokollauswahl und automatische Zuordnung für OpenAI Chat Completions, OpenAI Responses und Anthropic Messages ergänzt.\n\nEinstellungen für lokale und entfernte Websuche ergänzt. Lokale Quellen umfassen Baidu, Bing, DuckDuckGo, Sogou und 360 Search. Entfernte Konfigurationen speichern und prüfen Dienst-URLs, Modelle und API-Schlüssel für Responses- und Messages-Dienste.";
"updates.history.26.8" = "Native LaTeX-Darstellung mit quelltexterhaltendem Kopieren ergänzt. Codeblöcke erhielten Syntaxhervorhebung, horizontales Scrollen, Sprachkennzeichnungen und Kopieren per Tipp sowie stabilere Darstellung beim Streaming.\n\nFormatierungshinweise für Markdown, Code, Mathematik und Tabellen vereinheitlicht. Englische und chinesische Produktdokumentation, Abhängigkeitslizenzen und Xcode Cloud-Metadaten aktualisiert.";
"updates.history.26.7" = "Ersteinrichtung für Sprache, KI-Dienst und Chat- oder professionellen Modus mit fünf Oberflächensprachen neu gestaltet.\n\nArbeitsabläufe für Kamera, Fotos, Dateien, Web und lange Dokumente verbessert. Verbrauchsanzeigen und Kontextorganisation im professionellen Modus ergänzt sowie Fortschritt, Antwortaktionen, Links, Bestätigungen, Einstellungen, Datenschutzhinweise und Zurücksetzen verfeinert.";
"updates.history.1.0.1" = "Historischer Vorabversionseintrag: Die ursprünglichen Versionshinweise beschreiben diese Version als Entwurf/Vorabversion.\n\nGruppierte Einstellungen, Datenverwaltung, Systeminformationen und Datenschutzeinträge ergänzt. Promptkontext von Chat- und professionellem Modus getrennt, Projekt- und Sitzungsverwaltung verbessert, das feste Ressourcenzeitlimit von 300 Sekunden für Modellanfragen entfernt und Abstände im Chatkopf angepasst.";
"updates.history.1.0.0" = "Modellverwaltung neu aufgebaut und Einrichtung sowie Prüfung für GLM / Z.AI, DeepSeek, lokale Dienste und benutzerdefinierte Endpunkte verbessert.\n\nPP-OCRv6 Tiny OCR, multimodale Arbeitsabläufe, Eingabe mehrerer Bilder und konfigurierbare Bildverständnismodelle ergänzt. Eingabefeld, Anhänge und Oberflächenkomponenten verfeinert, Planungs- und Zielabläufe erweitert, gestreamtes Denken ergänzt sowie Hintergrundpersistenz, Sitzungswiederherstellung und Aufgabenstatusverwaltung gestärkt.";
