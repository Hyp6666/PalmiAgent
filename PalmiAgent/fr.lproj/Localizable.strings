// Palmi 26.11
"updates.26.11.chat" = "Palmi ouvre directement une conversation. Les modes Discussion et Professionnel offrent une expérience plus cohérente.";
"updates.26.11.interface" = "Une interface renouvelée rassemble historique, fichiers, compétences et réglages dans une nouvelle barre latérale.";
"updates.26.11.browser" = "Le contrôle du navigateur arrive en bêta ! En mode Professionnel, guidez-le avec vos mots, consultez plusieurs pages et reprenez la main pour vous connecter ou confirmer votre identité.";
"updates.26.11.models" = "Regroupez vos modèles et choisissez celui par défaut. Les anciens réglages à trois modèles sont transférés automatiquement. Changez aussi de modèle en pleine conversation.";
"updates.26.11.tools" = "Choisissez un modèle pour chaque outil :\nApprobation automatique ;\nAide visuelle pour les modèles sans vision ;\nRecherche web distante et lecture de pages ;\nCréation d’images.";
"updates.26.11.interactive" = "Des réponses interactives sans réglage supplémentaire : un pélican à vélo, Qin Shi Huang sur un ours polaire, Tetris ou la météo, à explorer dans la réponse.";
"updates.26.11.replies" = "Les réponses apparaissent pendant leur rédaction, mêlant texte, images et contenus interactifs. Continuez avec les suggestions de messages.";
"updates.26.11.files" = "Parcourez les fichiers des projets, ouvrez les dossiers, prévisualisez et partagez les fichiers, et consultez plus facilement les pièces jointes.";
"updates.26.11.questions" = "Les questions s’affichent sur votre écran actuel. Répondez à la suite, ajoutez des précisions, ou retrouvez la conversation à l’origine de la question.";
"updates.26.11.background" = "Travail en arrière-plan amélioré avec une progression plus réactive, y compris pour les réponses Bioniques. Les anciennes limites de durée et de tours n’interrompent plus les longues tâches.";
"updates.26.11.bionic" = "Conversations Bioniques et rappels de messages non lus améliorés. Le statut de lecture est plus précis à l’ouverture.";
"updates.26.11.languages" = "Ajout de l’allemand, du suédois, de l’arabe, du turc, de l’indonésien et du français. Réponses et titres suivent mieux la langue choisie.";
"updates.26.11.navigation" = "Correction de la perte de conversation après avoir réduit le navigateur et du mauvais mode sélectionné en ouvrant la barre latérale depuis le mode Bionique.";

