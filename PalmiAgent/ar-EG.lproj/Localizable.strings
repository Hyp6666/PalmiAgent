// Palmi 26.11
"updates.26.11.chat" = "افتح Palmi وابدأ المحادثة مباشرة، مع تجربة أكثر اتساقًا بين وضع المحادثة والوضع الاحترافي.";
"updates.26.11.interface" = "واجهة جديدة تجمع سجل المحادثات والملفات والمهارات والإعدادات في شريط جانبي.";
"updates.26.11.browser" = "التحكم في المتصفح متاح تجريبيًا! وجّهه بكلماتك في الوضع الاحترافي، واعرض صفحات متعددة وتولَّ التحكم عند تسجيل الدخول أو التحقق.";
"updates.26.11.models" = "رتّب النماذج في مجموعات واختر نموذجًا افتراضيًا. تنتقل إعدادات النماذج الثلاثة القديمة تلقائيًا، ويمكنك التبديل أثناء المحادثة.";
"updates.26.11.tools" = "اختر نماذج مستقلة لمزيد من الأدوات:\nالموافقة التلقائية؛\nمساعدة بصرية للنماذج التي لا ترى الصور؛\nالبحث البعيد على الويب وقراءة الصفحات؛\nإنشاء الصور.";
"updates.26.11.interactive" = "ردود تفاعلية دون إعداد إضافي: بجع يركب دراجة، أو تشين شي هوانغ على دب قطبي، أو تتريس، أو الطقس، مباشرة داخل الرد.";
"updates.26.11.replies" = "تظهر الردود أثناء كتابتها وتجمع النص والصور والمحتوى التفاعلي. واصل الحديث باقتراحات الرسائل التالية.";
"updates.26.11.files" = "تصفّح ملفات المشروعات وافتح المجلدات وعاين الملفات وشاركها، واعرض مرفقات المحادثات بسهولة أكبر.";
"updates.26.11.questions" = "تظهر الأسئلة فوق الشاشة الحالية عندما يحتاج Palmi قرارك. أجب تباعًا وأضف تفاصيل أو عُد إلى المحادثة التي سألتك.";
"updates.26.11.background" = "تحسين العمل في الخلفية وعرض التقدم، بما فيه ردود وضع المحاكاة البشرية. لم تعد المهام الطويلة تتوقف بسبب حدود الوقت والجولات السابقة.";
"updates.26.11.bionic" = "تحسين محادثات المحاكاة البشرية وحالة القراءة وتنبيهات الرسائل غير المقروءة عند فتح المحادثة.";
"updates.26.11.languages" = "إضافة الألمانية والسويدية والعربية والتركية والإندونيسية والفرنسية. تتبع الردود وعناوين المحادثات لغتك المختارة بصورة أفضل.";
"updates.26.11.navigation" = "إصلاح فقدان المحادثة الحالية بعد طي المتصفح واختيار الوضع الخاطئ عند فتح الشريط الجانبي من وضع المحاكاة البشرية.";

