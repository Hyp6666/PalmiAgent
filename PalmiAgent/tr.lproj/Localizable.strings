"bionic.pro.help.memory" = "Karakterler, sonraki konuşmalarda kullanmak için sohbet sırasında anıları düzenler ve kaydeder. Ücretsiz plan bu anıları otomatik kullanır. Pro ayrıca anıları incelemenizi, kaynaklarını izlemenizi ve düzenlemenizi sağlar.";
"bionic.pro.help.harness" = "Harness; karakter ayarlarını, hafızayı, sohbet bağlamını ve araçları modelin çevresinde koordine ederek Bionic modunda kullanılan etkileşimleri sağlar.";
"bionic.pro.help.longChat" = "Uzun sohbetler sürekliliği korumak için otomatik özetlenir. Bu, modelin tek seferde sınırsız metin okuyabildiği veya geçmişindeki her kelimeyi hatırladığı anlamına gelmez. Sonuçlar modelin ve cihazın yeteneklerine bağlıdır.";
"bionic.pro.help.memoryJump" = "Bir anının nereden geldiğini anlamak için bağlantılı sohbetine gidin. Özgün sohbetin hâlâ cihazınızda saklanıyor olması gerekir.";
"bionic.pro.help.diary" = "Karakterlerin deneyimlerini nasıl kaydettiklerini görmek için ürettikleri günlükleri okuyun. Bunlar modelin ürettiği karakter anlatılarıdır ve yanlış yorumlar içerebilir.";
"bionic.pro.help.developer" = "Karakter yanıtlarının nasıl üretildiğini anlamak için Bionic oturumlarının bağlamını ve tanılama bilgilerini inceleyin. Sistemin nasıl çalıştığının ayrıntılarıyla ilgilenen kullanıcılara yöneliktir.";
"personalization.personality.help" = "Yalnızca Profesyonel modda geçerlidir; ifade ve etkileşim üslubunu ayarlar. Sohbet modu bu ayarı kullanmaz; Bionic modu her karakterin kendi ayarlarını kullanır.";
