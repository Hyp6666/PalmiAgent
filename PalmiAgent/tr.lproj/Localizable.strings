// Palmi 26.11
"updates.26.11.chat" = "Palmi doğrudan bir konuşmayla açılır. Sohbet ve Profesyonel modları daha tutarlı bir deneyim sunar.";
"updates.26.11.interface" = "Yeni arayüz; geçmişi, dosyaları, becerileri ve ayarları bir kenar çubuğunda toplar.";
"updates.26.11.browser" = "Tarayıcı kontrolü beta olarak geldi! Profesyonel modda kendi sözlerinizle yönlendirin, birden fazla sayfayı görün, giriş veya doğrulama için kontrolü devralın.";
"updates.26.11.models" = "Modelleri gruplandırın ve varsayılanı seçin. Eski üç modelli ayarlarınız otomatik taşınır. Konuşma sırasında da model değiştirebilirsiniz.";
"updates.26.11.tools" = "Daha fazla araç için ayrı model seçin:\nOtomatik onay;\nGörselleri göremeyen modeller için görsel yardım;\nUzaktan web araması ve sayfa okuma;\nGörsel oluşturma.";
"updates.26.11.interactive" = "Ek ayar gerektirmeyen etkileşimli yanıtlar: bisiklet süren pelikan, kutup ayısına binen Qin Shi Huang, Tetris veya hava durumu, doğrudan yanıtın içinde.";
"updates.26.11.replies" = "Yanıtlar yazılırken görünür; metin, görsel ve etkileşimli içerik birleşir. Önerilen mesajlarla sohbeti sürdürün.";
"updates.26.11.files" = "Proje dosyalarını birlikte gezin, klasörleri açın, dosyaları önizleyip paylaşın ve ekleri daha kolay görüntüleyin.";
"updates.26.11.questions" = "Kararınız gerektiğinde sorular mevcut ekranın üzerinde görünür. Sırayla yanıtlayın, ayrıntı ekleyin, veya soran konuşmaya dönün.";
"updates.26.11.background" = "Biyonik yanıtlar dahil arka plan çalışması ve ilerleme gösterimi iyileştirildi. Uzun görevler önceki süre ve tur sınırlarıyla kesilmez.";
"updates.26.11.bionic" = "Biyonik sohbetler, okundu durumu ve okunmamış mesaj hatırlatmaları iyileştirildi.";
"updates.26.11.languages" = "Almanca, İsveççe, Arapça, Türkçe, Endonezce ve Fransızca eklendi. Yanıtlar ve konuşma başlıkları da dil seçiminizi daha iyi izler.";
"updates.26.11.navigation" = "Tarayıcı kapatılınca mevcut konuşmanın kaybolması ve Biyonik moddan kenar çubuğu açıldığında yanlış modun seçilmesi düzeltildi.";

